{
  "name": "@unabandoned/browser-pack",
  "version": "6.1.3",
  "description": "pack node-style source files from a json stream into a browser bundle",
  "main": "index.js",
  "bin": {
    "browser-pack": "bin/cmd.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/browser-pack.git"
  },
  "bugs": {
    "url": "https://github.com/unabandoned/browser-pack/issues"
  },
  "homepage": "https://github.com/unabandoned/browser-pack#readme",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "browser",
    "bundle",
    "commonjs",
    "commonj-esque",
    "exports",
    "module.exports",
    "require"
  ],
  "dependencies": {
    "JSONStream": "npm:@unabandoned/jsonstream@^1",
    "combine-source-map": "npm:@unabandoned/combine-source-map@^1.0.0",
    "umd": "3.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "convert-source-map": "2.0.0",
    "parse-base64vlq-mappings": "0.1.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test test/*.js"
  },
  "author": {
    "name": "James Halliday",
    "email": "mail@substack.net",
    "url": "http://substack.net"
  },
  "license": "MIT"
}
